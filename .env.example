# Database
MONGODB_URI=                          # Atlas connection string (mongodb+srv://...)
MONGODB_DB=                           # database name (defaults to creator-coach)

# Auth
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_TWITCH_ID=                       # Twitch OAuth Client ID
AUTH_TWITCH_SECRET=                   # Twitch OAuth Client Secret
AUTH_GOOGLE_ID=                       # Google Cloud Console OAuth 2.0 Web client (APIs & Services → Credentials)
AUTH_GOOGLE_SECRET=                   # Google Cloud Console OAuth 2.0 Web client (APIs & Services → Credentials)
TOKEN_ENC_KEY=                        # 32-byte base64 key for token encryption at rest — generate: openssl rand -base64 32

# Error monitoring
SENTRY_DSN=                          # https://...ingest.sentry.io/...
SENTRY_AUTH_TOKEN=                   # Sentry auth token for source maps

# App
NEXT_PUBLIC_APP_URL=                 # https://creator-coach.vercel.app (or http://localhost:3000)
NODE_ENV=                            # development | production | test
